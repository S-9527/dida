{
  "name": "dida",
  "private": "true",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @dida/db generate",
    "db:migrate": "pnpm --filter @dida/db migrate",
    "db:deploy": "pnpm --filter @dida/db migrate:deploy",
    "db:push": "pnpm --filter @dida/db db:push",
    "db:seed": "pnpm --filter @dida/db db:seed",
    "db:studio": "pnpm --filter @dida/db db:studio"
  },
  "devDependencies": {
    "@dida/eslint-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}